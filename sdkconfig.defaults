# Setup Serial monitoring.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Flash configs and custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Enable Bluetooth
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Software coexistence for WiFi and Bluetooth
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Compiler optimizations
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Increase tick speed from 100hz
CONFIG_FREERTOS_HZ=1000

# Further optimizations
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y

# Optimize mbedTLS memory usage
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

# FATFS and Wear Levelling
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_PER_FILE_CACHE=n
CONFIG_WL_SECTOR_SIZE_4096=y

# OTA rollback on failed boot
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

### Disable logging and enable encryption on production/remote deployed devices ###
# Disable logging (uncomment for production silence)
#CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
#CONFIG_BOOTLOADER_LOG_LEVEL=0
#CONFIG_LOG_DEFAULT_LEVEL_NONE=y
#CONFIG_LOG_DEFAULT_LEVEL=0

# Encryption Settings
# Leave USB/UART Download Mode Unrestricted (prevents auto-bricking the USB port)
CONFIG_SECURE_INSECURE_ALLOW_DL_MODE=y
# Enable Hardware Flash Encryption (uncomment to enable)
#CONFIG_SECURE_FLASH_ENC_ENABLED=y
#CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
